# Local defaults. Copy only if you need to customize; never commit .env.
DATABASE_URL=sqlite:///storage/verity.db
STORAGE_DIR=storage
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:5178,http://127.0.0.1:5178,http://localhost:8080,http://127.0.0.1:8080
# Optional local vision-language inference. Leave the model empty to disable.
OLLAMA_MODEL=
OLLAMA_URL=http://127.0.0.1:11434
# Optional override when Tesseract is installed outside PATH / standard Windows directory.
TESSERACT_CMD=
# Docker PostgreSQL password: set your own before starting Compose.
POSTGRES_PASSWORD=
